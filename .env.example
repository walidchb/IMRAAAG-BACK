PORT=3000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname
JWT_SECRET=your-jwt-secret-min-32-chars
NODE_ENV=development

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
FRONTEND_URL=http://localhost:3001

R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=imraaah
R2_PUBLIC_URL=https://pub-your-id.r2.dev

DHD_STATUS_SYNC_ENABLED=false
DHD_STATUS_SYNC_INTERVAL_MINUTES=15
DHD_STATUS_SYNC_MAX_CALLS_PER_MINUTE=20
DHD_STATUS_SYNC_TERMINAL_CONFIRMATIONS=3
DHD_STATUS_SYNC_LEASE_SECONDS=120
DHD_STATUS_SYNC_DELIVERED_WATCH_DAYS=14
DHD_STATUS_SYNC_DELIVERED_POLL_MINUTES=60
DHD_STATUS_UTC_OFFSET=+01:00
DHD_STATUS_API_BASE=
DHD_STATUS_AUTH_MODE=bearer

NOEST_STATUS_SYNC_ENABLED=false
NOEST_STATUS_SYNC_INTERVAL_MINUTES=15
NOEST_STATUS_SYNC_MAX_CALLS_PER_MINUTE=20
NOEST_STATUS_SYNC_TERMINAL_CONFIRMATIONS=3
NOEST_STATUS_SYNC_LEASE_SECONDS=120
NOEST_STATUS_SYNC_DELIVERED_WATCH_DAYS=14
NOEST_STATUS_SYNC_DELIVERED_POLL_MINUTES=60


# Carrier shipping-label printing (off by default)
ORDER_LABELS_ENABLED=false
ORDER_LABELS_STORE_ALLOWLIST=
ORDER_LABELS_MAX_ORDERS=100
ORDER_LABELS_RENDER_CONCURRENCY=2
ORDER_LABELS_CARRIER_CONCURRENCY=5
ORDER_LABELS_JOB_TIMEOUT_MS=90000
ORDER_LABELS_RENDER_TIMEOUT_MS=15000
ORDER_LABELS_ARTIFACT_TTL_HOURS=24
ZR_LABEL_API_BASE=https://api.zrexpress.app/api/v1
ECOM_LABEL_API_BASE=https://ecom-dz.com/api_v2
DHD_LABEL_API_BASE=https://platform.dhd-dz.com/api/v1
DHD_LABEL_AUTH_MODE=bearer
NOEST_LABEL_API_BASE=https://app.noest-dz.com
PUPPETEER_EXECUTABLE_PATH=
