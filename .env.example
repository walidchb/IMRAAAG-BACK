PORT=3000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname
JWT_SECRET=your-jwt-secret-min-32-chars
# Set to `production` on the deployed API. It enables secure auth cookies, the production
# CORS defaults, and https://vendor.imraaah.com password-reset links.
NODE_ENV=development

# Comma-separated allowed browser origins, checked against the Origin header. When unset,
# production defaults to https://imraaah.com,https://www.imraaah.com,https://vendor.imraaah.com
# and development allows localhost/127.0.0.1 on any port. Set this to override either default.
CORS_ORIGINS=https://imraaah.com,https://www.imraaah.com,https://vendor.imraaah.com,https://imraaah-front-storefront-git-dev-walidchbs-projects.vercel.app,https://imraaah-front-vendor-front-git-dev-walidchbs-projects.vercel.app

# Encrypts carrier API credentials at rest. REQUIRED in production. 64 hex characters:
#   openssl rand -hex 32
DELIVERY_ENCRYPTION_KEY=

# Set only when the API sits behind a trusted reverse proxy / load balancer. `1` for one hop,
# a CIDR, or `true`. Without it every request appears to come from the proxy and per-IP rate
# limits collapse into one bucket. See also: use a shared throttler store when running more
# than one API instance.
TRUST_PROXY=

# Swagger is disabled automatically when NODE_ENV=production. Set to `true` only for a
# private/staging deployment that is otherwise protected.
ENABLE_SWAGGER=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
# Vendor dashboard origin used in password-reset and team-invitation links.
# Required in production (there is no baked-in domain); falls back to http://localhost:3001.
FRONTEND_URL=https://vendor.imraaah.com

R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=imraaah
R2_PUBLIC_URL=https://pub-your-id.r2.dev

# Admin seed (`npm run seed`). Both values are REQUIRED when NODE_ENV=production; the seed
# refuses to run with defaults there and never hardcodes a known password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

DHD_STATUS_SYNC_ENABLED=false
DHD_STATUS_SYNC_INTERVAL_MINUTES=15
DHD_STATUS_SYNC_MAX_CALLS_PER_MINUTE=20
DHD_STATUS_SYNC_TERMINAL_CONFIRMATIONS=3
DHD_STATUS_SYNC_LEASE_SECONDS=120
DHD_STATUS_SYNC_DELIVERED_WATCH_DAYS=14
DHD_STATUS_SYNC_DELIVERED_POLL_MINUTES=60
DHD_STATUS_UTC_OFFSET=+01:00
DHD_STATUS_API_BASE=
DHD_STATUS_AUTH_MODE=bearer

NOEST_STATUS_SYNC_ENABLED=false
NOEST_STATUS_SYNC_INTERVAL_MINUTES=15
NOEST_STATUS_SYNC_MAX_CALLS_PER_MINUTE=20
NOEST_STATUS_SYNC_TERMINAL_CONFIRMATIONS=3
NOEST_STATUS_SYNC_LEASE_SECONDS=120
NOEST_STATUS_SYNC_DELIVERED_WATCH_DAYS=14
NOEST_STATUS_SYNC_DELIVERED_POLL_MINUTES=60

# DHD commune mapping (off by default). When enabled, dispatching a DHD order
# requires an explicit DHD commune selection (Order.dhdCommune) that matches the
# order's wilaya; the customer's canonical commune is never sent to DHD otherwise.
DHD_COMMUNE_MAPPING_ENABLED=false

# Noest commune mapping (off by default). When enabled, dispatching a Noest order
# through a customer commune that carries no `communes.noestexpress_uuid` requires an
# explicit Noest commune selection (Order.noestCommune) for the order's wilaya. A mapped
# commune needs no selection and triggers no carrier commune request.
NOEST_COMMUNE_MAPPING_ENABLED=false


# Carrier shipping-label printing (off by default)
ORDER_LABELS_ENABLED=false
ORDER_LABELS_MAX_ORDERS=100
ORDER_LABELS_RENDER_CONCURRENCY=2
ORDER_LABELS_CARRIER_CONCURRENCY=5
ORDER_LABELS_JOB_TIMEOUT_MS=90000
ORDER_LABELS_RENDER_TIMEOUT_MS=15000
ORDER_LABELS_ARTIFACT_TTL_HOURS=24
ZR_LABEL_API_BASE=https://api.zrexpress.app/api/v1
ECOM_LABEL_API_BASE=https://ecom-dz.com/api_v2
DHD_LABEL_API_BASE=https://platform.dhd-dz.com/api/v1
DHD_LABEL_AUTH_MODE=bearer
NOEST_LABEL_API_BASE=https://app.noest-dz.com
PUPPETEER_EXECUTABLE_PATH=

# Team Management invitations. Tokens are single-use, hashed at rest, and expire after this many hours.
# TEAM_ACCEPT_URL optionally overrides the accept URL base. It may be the full accept page
# (e.g. https://vendor.example.com/en/accept-invitation) or just the dashboard origin
# (e.g. https://vendor.example.com); otherwise FRONTEND_URL/en/accept-invitation is used.
TEAM_INVITATION_EXPIRY_HOURS=48
TEAM_ACCEPT_URL=
