PORT=3000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname
JWT_SECRET=your-jwt-secret-min-32-chars
# Set to `production` on every deployed API (Vercel Production and the dev Vercel project).
# It enables secure auth cookies and production fail-fast env validation.
NODE_ENV=development

# Exact browser origins for THIS environment. REQUIRED in production; there is no hardcoded
# fallback. Keep production and dev values separate.
# Production:
CORS_ORIGINS=https://imraaah.com,https://vendor.imraaah.com
# Dev (use in the dev Vercel project):
# CORS_ORIGINS=https://dev.imraaah.com,https://vendor.dev.imraaah.com
# Add any Vercel preview/deployment URLs here only if they must call the API directly.

# Store-root domain whose apex and subdomains are accepted automatically, so store hosts need
# no per-store CORS entry. REQUIRED in production. Production stores live at
# <store>.imraaah.com; dev stores live at <store>.dev.imraaah.com.
CORS_SUBDOMAIN_ROOTS=imraaah.com
# Dev (use in the dev Vercel project):
# CORS_SUBDOMAIN_ROOTS=dev.imraaah.com

# Encrypts carrier API credentials at rest. REQUIRED in production. 64 hex characters:
#   openssl rand -hex 32
DELIVERY_ENCRYPTION_KEY=

# Trusted reverse proxy. REQUIRED in production (the API refuses to start without it).
# On Vercel use `vercel` (exactly one Vercel edge proxy hop; maps to Express trust proxy = 1).
# For local direct development leave this empty (or set `false`).
# Use a hop count (`1`), a CIDR/IP list, or `false` only when the topology genuinely differs.
# Never use `true` on a public deployment: it trusts client-supplied X-Forwarded-For values.
TRUST_PROXY=vercel

# Swagger is disabled automatically when NODE_ENV=production. Set to `true` only for a
# private/staging deployment that is otherwise protected.
ENABLE_SWAGGER=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
# Vendor dashboard origin used in password-reset and team-invitation links.
# REQUIRED in production (there is no baked-in domain); the API refuses to start without it.
# Production:
FRONTEND_URL=https://vendor.imraaah.com
# Dev (use in the dev Vercel project):
# FRONTEND_URL=https://vendor.dev.imraaah.com

R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=imraaah
# REQUIRED in production and must be an absolute https:// URL. It is the public bucket/CDN
# origin used to build every stored image URL.
R2_PUBLIC_URL=https://pub-your-id.r2.dev

# Upload limits. Vercel Functions cap the total request body at 4.5 MB, so both values below
# are clamped to 4 MB (leaving room for multipart overhead). The browser compresses images to
# ~700 KB before upload; these are safety ceilings, not targets. Do not raise them above the
# Vercel limit. Direct-to-R2 uploads are the path for larger files later.
UPLOAD_MAX_FILE_BYTES=4194304
UPLOAD_MAX_TOTAL_BYTES=4194304
UPLOAD_MAX_FILES=10
UPLOAD_CONCURRENCY=2
UPLOAD_MAX_INPUT_PIXELS=40000000

# Admin seed (`npm run seed`). Both values are REQUIRED when NODE_ENV=production; the seed
# refuses to run with defaults there and never hardcodes a known password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

DHD_STATUS_SYNC_ENABLED=false
DHD_STATUS_SYNC_INTERVAL_MINUTES=15
DHD_STATUS_SYNC_MAX_CALLS_PER_MINUTE=20
DHD_STATUS_SYNC_TERMINAL_CONFIRMATIONS=3
DHD_STATUS_SYNC_LEASE_SECONDS=120
DHD_STATUS_SYNC_DELIVERED_WATCH_DAYS=14
DHD_STATUS_SYNC_DELIVERED_POLL_MINUTES=60
DHD_STATUS_UTC_OFFSET=+01:00
DHD_STATUS_API_BASE=
DHD_STATUS_AUTH_MODE=bearer

NOEST_STATUS_SYNC_ENABLED=false
NOEST_STATUS_SYNC_INTERVAL_MINUTES=15
NOEST_STATUS_SYNC_MAX_CALLS_PER_MINUTE=20
NOEST_STATUS_SYNC_TERMINAL_CONFIRMATIONS=3
NOEST_STATUS_SYNC_LEASE_SECONDS=120
NOEST_STATUS_SYNC_DELIVERED_WATCH_DAYS=14
NOEST_STATUS_SYNC_DELIVERED_POLL_MINUTES=60

# DHD commune mapping (off by default). When enabled, dispatching a DHD order
# requires an explicit DHD commune selection (Order.dhdCommune) that matches the
# order's wilaya; the customer's canonical commune is never sent to DHD otherwise.
DHD_COMMUNE_MAPPING_ENABLED=false

# Noest commune mapping (off by default). When enabled, dispatching a Noest order
# through a customer commune that carries no `communes.noestexpress_uuid` requires an
# explicit Noest commune selection (Order.noestCommune) for the order's wilaya. A mapped
# commune needs no selection and triggers no carrier commune request.
NOEST_COMMUNE_MAPPING_ENABLED=false


# Carrier shipping-label printing (off by default)
ORDER_LABELS_ENABLED=false
ORDER_LABELS_MAX_ORDERS=100
ORDER_LABELS_RENDER_CONCURRENCY=2
ORDER_LABELS_CARRIER_CONCURRENCY=5
ORDER_LABELS_JOB_TIMEOUT_MS=90000
ORDER_LABELS_RENDER_TIMEOUT_MS=15000
ORDER_LABELS_ARTIFACT_TTL_HOURS=24
ZR_LABEL_API_BASE=https://api.zrexpress.app/api/v1
ECOM_LABEL_API_BASE=https://ecom-dz.com/api_v2
DHD_LABEL_API_BASE=https://platform.dhd-dz.com/api/v1
DHD_LABEL_AUTH_MODE=bearer
NOEST_LABEL_API_BASE=https://app.noest-dz.com
PUPPETEER_EXECUTABLE_PATH=

# Team Management invitations. Tokens are single-use, hashed at rest, and expire after this many hours.
# TEAM_ACCEPT_URL optionally overrides the accept URL base. It may be the full accept page
# (e.g. https://vendor.example.com/en/accept-invitation) or just the dashboard origin
# (e.g. https://vendor.example.com); otherwise FRONTEND_URL/en/accept-invitation is used.
TEAM_INVITATION_EXPIRY_HOURS=48
TEAM_ACCEPT_URL=

# Product & Box view analytics (off by default; disabling never deletes stored rows)
ITEM_VIEW_ANALYTICS_ENABLED=false
# Dedicated, stable salt for visitor hashes. REQUIRED when the feature is enabled in a
# production build (including Vercel Preview). Generate with `openssl rand -hex 32`.
# Do not change it after launch: every stored hash is tied to the salt, so rotating it makes
# all existing visitors look new. It must NOT fall back to JWT_SECRET in production.
ITEM_VIEW_HASH_SALT=
ITEM_VIEW_RETENTION_DAYS=0
